# =========================
# PixelPilot controller
# =========================
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=0
DATABASE_PATH=./pixelpilot.sqlite3
LOG_LEVEL=INFO

# =========================
# Vast.ai
# =========================
VAST_API_KEY=
# Optional. This is the Vast template content hash, not a numeric template id.
VAST_TEMPLATE_HASH=
VAST_DOCKER_IMAGE=vastai/pytorch:@vastai-automatic-tag

# Qwen-Image-2.1 checkpoint + Python runtime + Hugging Face cache.
VAST_DISK_GB=100
# 24 GB works through CPU offload. 48 GB+ is preferred for full-GPU execution.
VAST_MIN_GPU_RAM_GB=24
VAST_PREFERRED_GPU_RAM_GB=48
# Applied to CPU-offload searches; full-GPU offers have no host-RAM floor.
VAST_MIN_CPU_RAM_GB=48
VAST_MIN_RELIABILITY=0.98
VAST_MAX_PRICE_USD_HOUR=0.50
VAST_DEFAULT_LIMIT=8
# Number of live candidates inspected per marketplace query before local ranking.
VAST_SEARCH_POOL_LIMIT=64
VAST_VERIFIED_ONLY=true
VAST_DATACENTER_ONLY=false
VAST_MIN_DIRECT_PORTS=1
VAST_MIN_INET_DOWN_MBPS=100
VAST_CANCEL_UNAVAILABLE=true
VAST_AUTO_DESTROY_ON_PROVISION_FAILURE=false

# Cost-comparison assumptions, NOT measured usage or a promised final invoice.
# The billed period includes setup; hourly dph_total already includes allocated disk.
VAST_ESTIMATED_DOWNLOAD_GB=70
VAST_COST_COMPARISON_HOURS=1
# Optional inbound rate ceiling in USD/TB, with 1 TB = 1000 GB.
# Leave this key absent/commented for no rate ceiling. Do not set an empty value.
# A configured ceiling excludes unknown rates. 0 permits genuinely free download only.
# Example only; enable a ceiling after reviewing the desired policy:
# VAST_MAX_DOWNLOAD_USD_PER_TB=5

# Repository source used by an ephemeral Vast instance.
PIXELPILOT_REPO_URL=
# Must match the controller's deployed, published branch or tag.
# This unmerged continuation is not on main yet. Update both together after integration.
PIXELPILOT_REPO_REF=fix/vast-download-cost-awareness

# =========================
# Hugging Face
# =========================
# Optional; the model is public. A read token can improve download reliability.
HF_TOKEN=

# =========================
# Qwen-Image-2.1
# =========================
MODEL_ID=Qwen/Qwen-Image-2.1
MODEL_DTYPE=bfloat16
# auto: full GPU on 48 GB+, CPU offload below that.
# gpu: force full GPU. offload: always use CPU offload.
IMAGE_MEMORY_MODE=auto
IMAGE_FULL_GPU_MIN_VRAM_GB=48
IMAGE_VAE_TILING=true
IMAGE_VAE_SLICING=true
IMAGE_DEFAULT_STEPS=40
IMAGE_MAX_REFERENCE_IMAGES=10
IMAGE_MAX_UPLOAD_MB=25

# Optional official Qwen prompt enhancement (owner-controlled in Telegram).
PROMPT_ENHANCER_T2I_ID=Qwen/Qwen-Image-2.1-PE-T2I
PROMPT_ENHANCER_I2I_ID=Qwen/Qwen-Image-2.1-PE-I2I
# No optional downloads on startup/Original. The first explicit enhanced request
# starts only its required T2I or I2I checkpoint download; until cached, use Original.
# Optional downloads add transfer charges and are not included in the base allowance.

# Public authenticated PixelPilot image endpoint.
INFERENCE_PORT=8190
INFERENCE_USE_HTTPS=false
INFERENCE_VERIFY_TLS=false
INFERENCE_REQUEST_TIMEOUT_SECONDS=3600
# Short timeout for health/status probes; generation keeps the long timeout above.
INFERENCE_PROBE_TIMEOUT_SECONDS=5
# Keep Telegram status checks bounded even if the Vast API is slow.
VAST_STATUS_TIMEOUT_SECONDS=8
INFERENCE_READY_TIMEOUT_SECONDS=2400
PROVISION_POLL_SECONDS=5

# =========================
# Cost guard
# =========================
# Time/idle policy, not a live transfer-spend meter or total-invoice ceiling.
COST_GUARD_WARN_MINUTES=30
COST_GUARD_AUTO_DESTROY_MINUTES=0
COST_GUARD_POLL_SECONDS=60
