# =========================
# PixelPilot controller
# =========================
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=0
DATABASE_PATH=./pixelpilot.sqlite3
LOG_LEVEL=INFO

# =========================
# Vast.ai
# =========================
VAST_API_KEY=
# Optional. IMPORTANT: this is the content hash (hash_id/template_hash), not numeric template id.
VAST_TEMPLATE_HASH=
VAST_DOCKER_IMAGE=vastai/pytorch:@vastai-automatic-tag
VAST_DISK_GB=100
VAST_MIN_GPU_RAM_GB=48
VAST_MIN_RELIABILITY=0.98
VAST_MAX_PRICE_USD_HOUR=1.50
VAST_DEFAULT_LIMIT=8
VAST_VERIFIED_ONLY=true
VAST_DATACENTER_ONLY=false
VAST_MIN_DIRECT_PORTS=2
VAST_MIN_INET_DOWN_MBPS=100
VAST_CANCEL_UNAVAILABLE=true
# PixelPilot never destroys a Vast instance automatically by default.
VAST_AUTO_DESTROY_ON_PROVISION_FAILURE=false

# Repository source used by an ephemeral Vast instance.
PIXELPILOT_REPO_URL=
PIXELPILOT_REPO_REF=main

# =========================
# Hugging Face
# =========================
# Optional for the current public Comfy-Org FLUX.2 Dev quantized files.
# Keep a read-only token here only if future model files require it.
HF_TOKEN=

# =========================
# Vast worker / ComfyUI
# =========================
WORKER_PROXY_PORT=8190
WORKER_INTERNAL_PORT=18190
# Worker is exposed directly through the mapped Vast TCP port over HTTP and
# authenticates every request with its bearer token.
WORKER_USE_HTTPS=false
WORKER_VERIFY_TLS=false
WORKER_REQUEST_TIMEOUT_SECONDS=60
WORKER_GENERATION_TIMEOUT_SECONDS=900
COMFY_PORT=8188
COMFY_READY_TIMEOUT_SECONDS=1200
PROVISION_READY_TIMEOUT_SECONDS=1800
PROVISION_POLL_SECONDS=5
COMFYUI_REF=v0.35.0
WORKFLOW_PATH=./resources/workflows/flux2_dev_api.json

# Generation limits
GENERATION_MAX_BATCH=4
GENERATION_DEFAULT_STEPS=28
GENERATION_MAX_STEPS=50

# =========================
# Cost guard
# =========================
COST_GUARD_WARN_MINUTES=30
# 0 = disabled. Instance deletion remains manual.
COST_GUARD_AUTO_DESTROY_MINUTES=0
COST_GUARD_POLL_SECONDS=60
