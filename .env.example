# =========================
# PixelPilot controller
# =========================
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=0
DATABASE_PATH=./pixelpilot.sqlite3
LOG_LEVEL=INFO

# =========================
# Vast.ai
# =========================
VAST_API_KEY=
# Optional. This is the Vast template content hash, not a numeric template id.
VAST_TEMPLATE_HASH=
VAST_DOCKER_IMAGE=vastai/pytorch:@vastai-automatic-tag
# Qwen2.5-Omni-7B is much lighter than Qwen3-Omni 30B; 80 GB disk leaves room for vLLM and cache.
VAST_DISK_GB=80
# Default economy profile targets 48 GB GPUs such as A6000 / RTX 6000 Ada / L40S.
VAST_MIN_GPU_RAM_GB=48
VAST_MIN_RELIABILITY=0.98
# Hard ceiling for any offer PixelPilot may rent.
VAST_MAX_PRICE_USD_HOUR=0.50
VAST_DEFAULT_LIMIT=8
VAST_VERIFIED_ONLY=true
VAST_DATACENTER_ONLY=false
VAST_MIN_DIRECT_PORTS=1
VAST_MIN_INET_DOWN_MBPS=100
VAST_CANCEL_UNAVAILABLE=true
# PixelPilot never destroys a Vast instance automatically on provisioning failure by default.
VAST_AUTO_DESTROY_ON_PROVISION_FAILURE=false

# Repository source used by an ephemeral Vast instance.
PIXELPILOT_REPO_URL=
PIXELPILOT_REPO_REF=main

# =========================
# Hugging Face
# =========================
# Optional because Qwen2.5-Omni-7B is public. A read token can help authenticated Hub access.
HF_TOKEN=

# =========================
# Qwen2.5-Omni / vLLM
# =========================
MODEL_ID=Qwen/Qwen2.5-Omni-7B
MODEL_DTYPE=bfloat16
# 8K keeps the 48 GB profile comfortable while remaining ample for personal chat.
MODEL_MAX_LEN=8192
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_GPU_MEMORY_UTILIZATION=0.92
MODEL_TENSOR_PARALLEL_SIZE=1
MODEL_LIMIT_IMAGES=1
MODEL_LIMIT_AUDIO=1

# vLLM's authenticated OpenAI-compatible endpoint on the rented instance.
INFERENCE_PORT=8190
INFERENCE_USE_HTTPS=false
INFERENCE_VERIFY_TLS=false
INFERENCE_REQUEST_TIMEOUT_SECONDS=600
INFERENCE_READY_TIMEOUT_SECONDS=1800
PROVISION_POLL_SECONDS=5

# Telegram session. Conversation history is RAM-only on the controller.
CHAT_HISTORY_MESSAGES=10
CHAT_MAX_MEDIA_MB=20

# =========================
# Cost guard
# =========================
COST_GUARD_WARN_MINUTES=30
# 0 = disabled. Instance deletion remains manual.
COST_GUARD_AUTO_DESTROY_MINUTES=0
COST_GUARD_POLL_SECONDS=60
