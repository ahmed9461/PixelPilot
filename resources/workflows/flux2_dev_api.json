{
  "1": {
    "inputs": {
      "unet_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {"title": "Load FLUX.2 Dev FP8 Mixed"}
  },
  "2": {
    "inputs": {
      "clip_name": "mistral_3_small_flux2_fp8.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load FLUX.2 Text Encoder"}
  },
  "3": {
    "inputs": {"vae_name": "flux2-vae.safetensors"},
    "class_type": "VAELoader",
    "_meta": {"title": "Load FLUX.2 VAE"}
  },
  "4": {
    "inputs": {
      "text": "A realistic photograph",
      "clip": ["2", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt"}
  },
  "5": {
    "inputs": {
      "conditioning": ["4", 0],
      "guidance": 4.0
    },
    "class_type": "FluxGuidance",
    "_meta": {"title": "FLUX.2 Guidance"}
  },
  "6": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {"title": "Image Size"}
  },
  "7": {
    "inputs": {"noise_seed": 0},
    "class_type": "RandomNoise",
    "_meta": {"title": "Noise"}
  },
  "8": {
    "inputs": {"sampler_name": "euler"},
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Euler Sampler"}
  },
  "9": {
    "inputs": {
      "steps": 28,
      "width": 1024,
      "height": 1024
    },
    "class_type": "Flux2Scheduler",
    "_meta": {"title": "FLUX.2 Scheduler"}
  },
  "10": {
    "inputs": {
      "model": ["1", 0],
      "conditioning": ["5", 0]
    },
    "class_type": "BasicGuider",
    "_meta": {"title": "Basic Guider"}
  },
  "11": {
    "inputs": {
      "noise": ["7", 0],
      "guider": ["10", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sampler"}
  },
  "12": {
    "inputs": {
      "samples": ["11", 0],
      "vae": ["3", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "13": {
    "inputs": {
      "filename_prefix": "PixelPilot",
      "images": ["12", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"}
  }
}
